#!/bin/sh
set -eu

secret_file="${XDG_CONFIG_HOME:-$HOME/.config}/agentmemory/secret"
url_file="${XDG_CONFIG_HOME:-$HOME/.config}/agentmemory/url"

if [ ! -r "$secret_file" ] || [ ! -s "$secret_file" ] || [ ! -r "$url_file" ]; then
    echo "Agentmemory configuration is missing under ${XDG_CONFIG_HOME:-$HOME/.config}/agentmemory" >&2
    exit 1
fi

AGENTMEMORY_URL=""
IFS= read -r AGENTMEMORY_URL < "$url_file" || [ -n "$AGENTMEMORY_URL" ]
[ -n "$AGENTMEMORY_URL" ] || {
    echo "Agentmemory URL is empty" >&2
    exit 1
}

AGENTMEMORY_SECRET_FILE=$secret_file
export AGENTMEMORY_SECRET_FILE AGENTMEMORY_URL
export AGENTMEMORY_REQUIRE_HTTPS="1"
export AGENTMEMORY_AUTO_CAPTURE="1"
export AGENT_ID="pi"

exec /usr/local/bin/pi-real "$@"
