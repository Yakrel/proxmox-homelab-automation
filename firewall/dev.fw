[OPTIONS]
enable: 1
policy_in: DROP
policy_out: ACCEPT
ipfilter: 1

[RULES]
# Orca headless runtime server & web UI (6768)
# Reverse Proxy Ingress from Gateway NPM (192.168.1.100)
IN ACCEPT -source 192.168.1.100 -p tcp -dport 6768
# Tailscale subnet router (PVE host 192.168.1.10, SNAT): tailnet clients reach
# Orca directly; the Tailscale policy decides who may.
IN ACCEPT -source 192.168.1.10 -p tcp -dport 6768
# Workstation (192.168.1.20)
IN ACCEPT -source 192.168.1.20 -p tcp -dport 6768
# Laptop (192.168.1.21)
IN ACCEPT -source 192.168.1.21 -p tcp -dport 6768
